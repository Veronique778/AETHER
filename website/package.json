{
  "name": "aether-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AETHER official website: interactive BODY twin, PHANTOM synthetic demo, evidence and Windows download (static, no backend).",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:offline": "node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "python tests/e2e.py --dist dist"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.4.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
