{
  "name": "aether-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "AETHER – Adaptive Ecosystem for Human Exploration and Resilience (Windows desktop app, Tauri 2)",
  "type": "module",
  "scripts": {
    "build:frontend": "node ../web/frontend/scripts/build-offline.mjs --mode live --out ../../desktop/dist",
    "build:backend": "node scripts/build-backend.mjs",
    "tauri": "tauri",
    "dev": "npm run build:backend && tauri dev",
    "build": "npm run build:backend && tauri build",
    "test:sidecar": "python -m pytest tests -q",
    "test:webview": "node tests/desktop-webview.mjs",
    "test:visual": "node tests/visual-regression.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0"
  }
}
